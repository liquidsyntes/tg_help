{
  "name": "tg-content-publisher",
  "version": "1.0.0",
  "description": "Telegram Content Publisher Bot MVP with role-based access, draft autosave, review workflow, and queued idempotent publishing",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "ts-node -r tsconfig-paths/register src/worker.main.ts",
    "start:worker:dev": "nest start --entryFile worker.main --watch",
    "start:worker:prod": "node dist/worker.main.js",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "test": "jest --config ./tests/jest.json",
    "test:watch": "jest --watch --config ./tests/jest.json",
    "test:cov": "jest --coverage --config ./tests/jest.json",
    "test:e2e": "node --test --experimental-strip-types tests/e2e/tier1-feature-coverage.spec.ts tests/e2e/tier2-boundary-cases.spec.ts tests/e2e/tier3-cross-feature.spec.ts tests/e2e/tier4-application-scenarios.spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.41.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "grammy": "^1.35.0",
    "ioredis": "^5.6.0",
    "luxon": "^3.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.11",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.7.3"
  }
}
