# Environment configuration
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://tghelp:tghelp_pass@127.0.0.1:5432/tghelp?schema=public

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Telegram Bot
BOT_TOKEN=123456789:AAABBBCCCDDDEEEFFFGGGHHHIIIJJJKKK11
TELEGRAM_MODE=polling

# Webhook configuration (only required if TELEGRAM_MODE=webhook)
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET_TOKEN=

# Channels & Scheduling
DEFAULT_TIMEZONE=Europe/Kyiv

# Initial Seeding
INITIAL_SUPER_ADMIN_TELEGRAM_ID=123456789
DEFAULT_CHANNEL_CHAT_ID=-1001234567890

# Logging
LOG_LEVEL=info
